# Zkopíruj tento soubor jako .env a doplň hodnoty. Soubor .env se nikdy nenahrává na GitHub.

# Klíč z https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Heslo do kanceláře. Když je vyplněné, kancelář je dostupná i z telefonu (např. přes Tailscale).
# Když je prázdné, běží jen na tomto počítači.
OFFICE_PASSWORD=

# Port serveru
PORT=8787

# Okno městečka (spouštění ikonou na ploše):
# pozice levého horního rohu okna x,y – např. 1980,80 pro druhý monitor vpravo od hlavního
OKNO_POZICE=
# ano = otevřít přes celou obrazovku
OKNO_CELA_OBRAZOVKA=ne

# Echo – zpravodaj (nepovinné; výchozí hodnoty jsou pro Lipník nad Bečvou)
# MISTO_NAZEV=Lipník nad Bečvou
# MISTO_LAT=49.5275
# MISTO_LON=17.5859
# REPORTER_MODEL=claude-haiku-5-5
# ZPRAVY_INTERVAL_MIN=10
# ZPRAVY=vypnuto   # úplně vypne stahování zpráv a plakátky

# Chronos – Google Kalendář (nepovinné; propojení se dělá v panelu Chronose)
# CHRONOS_MODEL=claude-sonnet-5-5
# PRACOVNI_DOBA=08:00-20:00
# PRACOVNI_DNY=1,2,3,4,5,6,7   # 1 = pondělí … 7 = neděle
# GOOGLE_CLIENT_ID=…apps.googleusercontent.com   # místo zadání v panelu
# GOOGLE_CLIENT_SECRET=…

# Echo – noční klid pro hodinové plakátky (od-do hodin; ne = psát i v noci)
# ECHO_NOC=0-6

# Jarvis (hlášení), Klik (spouštěč), Lexa, Bit – modely a oslovení (nepovinné)
# JARVIS_MODEL=claude-opus-5-5
# JARVIS_OSLOVENI=pane
# KLIK_MODEL=claude-haiku-5-5
# LEXA_MODEL=claude-haiku-5-5
# BIT_MODEL=claude-haiku-5-5

# Prohlížeč okna městečka: výchozí je Edge (má nejlepší české hlasy), chrome = Google Chrome
# PROHLIZEC=chrome

# Útrata – kurz pro přepočet na koruny
# KURZ_USD=23

# Automatické aktualizace z GitHubu při spuštění ikonou (ne = vypnout)
# AKTUALIZACE=ne
